{
  "name": "launchpad-factory-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Permissionless launchpad factory contracts for Robinhood Chain (alpha).",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "clean": "hardhat clean",
    "deploy:testnet": "hardhat run scripts/deploy.cjs --network robinhoodTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.cjs --network robinhood",
    "pad:testnet": "hardhat run scripts/createLaunchpad.cjs --network robinhoodTestnet",
    "test:fork": "FORK_RPC=${FORK_RPC:-https://rpc.mainnet.chain.robinhood.com} hardhat test test/fork/MainnetIntegration.fork.test.js",
    "test:swaps": "FORK_RPC=${FORK_RPC:-https://rpc.mainnet.chain.robinhood.com} hardhat test test/fork/RealSwaps.fork.test.js",
    "model:economics": "node scripts/modelEconomics.cjs",
    "deploy:market": "hardhat run scripts/deployMarket.cjs --network robinhood",
    "canary:preflight": "hardhat run scripts/canaryPreflight.cjs --network robinhood",
    "canary:rehearse": "FORK_RPC=${FORK_RPC:-https://rpc.mainnet.chain.robinhood.com} hardhat run scripts/canaryRehearsal.cjs",
    "test:verify": "FORK_RPC=${FORK_RPC:-https://rpc.mainnet.chain.robinhood.com} hardhat test test/fork/VerifyLaunch.fork.test.js",
    "verify:launch": "hardhat run scripts/verifyLaunch.cjs --network robinhood",
    "verify:baseline": "hardhat run scripts/verifyLaunch.cjs --network robinhood",
    "custody:check": "node scripts/custodyCheck.cjs"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.26.3"
  }
}
