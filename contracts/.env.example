# Copy to contracts/.env and fill in. NEVER commit the real .env — it is gitignored.

# ---------------------------------------------------------------------------
# Signing key. Use a throwaway testnet wallet. Never a wallet holding real funds.
# ---------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# RPC endpoints.
# Verified 2026-09-12 against https://docs.robinhood.com/chain/connecting
# These public endpoints are rate-limited and documented as not for production use.
# For production, Robinhood documents Alchemy/QuickNode endpoints instead.
# ---------------------------------------------------------------------------
RH_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
RH_MAINNET_RPC=https://rpc.mainnet.chain.robinhood.com

# ---------------------------------------------------------------------------
# Reserve asset.
#
# INTENTIONALLY BLANK. Do not paste an address you have not checked yourself.
# The deploy script verifies whatever you put here against Robinhood's live asset
# registry (https://api.robinhood.com/rhj/assets) and refuses to deploy on a mismatch.
#
# As of 2026-09-12 that registry lists canonical Robinhood Stock Tokens on chain 4663
# (mainnet) ONLY. There is no canonical NVDA on testnet 46630. For a testnet run you
# must deploy a clearly-labelled mock and set SKIP_NVDA_VERIFY=1 — and you must never
# describe that mock as real NVDA anywhere in the product.
# ---------------------------------------------------------------------------
NVDA_ADDRESS=
# SKIP_NVDA_VERIFY=1

# ---------------------------------------------------------------------------
# Fee destinations.
#
# PROTOCOL_TREASURY receives the execution/protocol leg.
#
# RESERVE_RECEIVER receives the 0.80% reserve leg. It MUST NOT be the ReserveVault
# address: the vault holds the reserve ERC-20 and rejects native currency by design.
# Until the constrained NVDA buyer module exists, this is a holding address and the
# funds sitting there are NOT NVDA and must not be presented as NVDA.
# ---------------------------------------------------------------------------
PROTOCOL_TREASURY=
RESERVE_RECEIVER=

# Optional: owner of ReserveVault's sweepNonReserve capability. Defaults to the deployer.
# VAULT_OWNER=

# ---------------------------------------------------------------------------
# Guards. Mainnet deployment is blocked unless this is explicitly set to 1.
# ---------------------------------------------------------------------------
# ALLOW_MAINNET=1

# Optional: contract verification.
# EXPLORER_API_KEY=
# EXPLORER_TESTNET_API_URL=
